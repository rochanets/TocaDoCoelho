# Exemplo sem credenciais reais. Copie para um arquivo fora do Git, substitua
# todos os valores REPLACE_ME e restrinja as permissões do arquivo.
TOCA_ENV=production
TOCA_AUTH_ENABLED=1
TOCA_COOKIE_SECURE=1
TOCA_COOKIE_SAMESITE=Lax
TOCA_TRUST_PROXY=1
WEB_CONCURRENCY=2
TOCA_MULTIWORKER_JOBS_ENABLED=1
TOCA_JOB_HEARTBEAT_SECONDS=30
TOCA_TASK_STATE_TTL_HOURS=24
TOCA_TIMEZONE=America/Sao_Paulo
TOCA_RUN_MIGRATIONS_ON_STARTUP=0
TOCA_LOG_FORMAT=json
TOCA_LOG_FILE_ENABLED=0
TOCA_IMAGE_TAG=local
TOCA_BUILD_SHA=REPLACE_ME_WITH_GIT_COMMIT_SHA
TOCA_BUILD_VERSION=REPLACE_ME_WITH_RELEASE_VERSION
TOCA_HTTP_PORT=80
TOCA_HTTPS_PORT=443

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# PostgreSQL do stack de referência. Para banco gerenciado, troque host,
# credenciais e parâmetros TLS conforme o fornecedor.
POSTGRES_DB=toca
POSTGRES_USER=toca
POSTGRES_PASSWORD=REPLACE_ME_WITH_A_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql://toca:REPLACE_ME_URL_ENCODED_PASSWORD@postgres:5432/toca

# Backup PostgreSQL executado pelo sidecar postgres-backup. O volume de backup
# precisa ser copiado/replicado para armazenamento externo conforme o runbook.
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14

# Mesmo App Registration público para SSO e Outlook Graph (Authorization Code
# + PKCE, sem client secret no Toca). Cadastre exatamente os dois redirects.
OUTLOOK_GRAPH_TENANT_ID=REPLACE_ME_TENANT_ID
OUTLOOK_GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
OUTLOOK_GRAPH_LOGIN_REDIRECT_URI=https://toca.example.com/api/auth/callback
OUTLOOK_GRAPH_REDIRECT_URI=https://toca.example.com/api/outlook/oauth/callback
OUTLOOK_GRAPH_LOGIN_SCOPE=openid profile email User.Read
OUTLOOK_GRAPH_SCOPE=offline_access Mail.Read Mail.Send User.Read

# WAHA sidecar. A chave plain é usada apenas pelo web no header X-Api-Key; o
# container WAHA recebe somente o hash SHA-512. As duas chaves devem ser
# aleatórias, diferentes e mantidas fora do Git. WAHA_SESSION_NAME é apenas o
# fallback do modo desktop/sem autenticação; no web cada usuário recebe um
# identificador opaco persistido em user_waha_sessions.
WAHA_API_KEY=REPLACE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
WAHA_API_KEY_HASH=sha512:REPLACE_ME_WITH_128_HEXADECIMAL_CHARACTERS
WAHA_WEBHOOK_HMAC_KEY=REPLACE_ME_WITH_ANOTHER_32_RANDOM_CHARACTERS
WAHA_SESSION_NAME=default

# Diretório local que contém fullchain.pem e privkey.pem. Nunca versione esses
# arquivos. Em produção, prefira montá-los a partir do secret store do host.
TLS_CERTS_DIR=./deploy/nginx/certs
